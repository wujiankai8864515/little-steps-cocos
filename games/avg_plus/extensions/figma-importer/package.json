        "methods": [
          "stopPushServer"
        ]
      },
      "stage-last-import-for-figma-pull": {
        "methods": [
          "stageLastImportForFigmaPull"
        ]
      },
      "export-tree-for-figma-pull": {
        "methods": [
          "exportTreeForFigmaPull"
        ]
      },
      "push-tree-to-figma": {
        "methods": [
          "pushTreeToFigma"
        ]
      },
      "export-tree-to-json-file": {
        "methods": [
          "exportTreeToJsonFile"
        ]
      },
      "save-node-as-prefab-beta": {
