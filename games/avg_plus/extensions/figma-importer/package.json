          "replaceSelectedFromJsonBeta"
        ]
      },
      "replace-selected-matched-node-from-json-beta": {
        "methods": [
          "replaceSelectedMatchedNodeFromJsonBeta"
        ]
      },
      "scan-json-replace-candidates-beta": {
        "methods": [
          "scanJsonReplaceCandidatesBeta"
        ]
      },
      "load-json-preview-beta": {
        "methods": [
          "loadJsonPreviewBeta"
        ]
      },
      "scan-json-textures-beta": {
        "methods": [
          "scanJsonTexturesBeta"
        ]
      },
      "import-missing-textures-beta": {
        "methods": [
          "importMissingTexturesBeta"
        ]
      },
      "apply-matched-node-to-selected-beta": {
        "methods": [
          "applyMatchedNodeToSelectedBeta"
        ]
      },
      "apply-json-node-to-target-beta": {
        "methods": [
