          "snapshotReplaceTargetBeta"
        ]
      },
      "restore-replace-target-beta": {
        "methods": [
          "restoreReplaceTargetBeta"
        ]
      },
      "select-replace-target-beta": {
        "methods": [
          "selectReplaceTargetBeta"
        ]
      },
      "apply-matched-nodes-to-selected-root-beta": {
