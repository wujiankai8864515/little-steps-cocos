        "methods": [
          "scanComponentIdentitiesFromJson"
        ]
      },
      "upsert-component-mapping": {
        "methods": [
          "upsertComponentMapping"
        ]
      },
      "remove-component-mapping": {
        "methods": [
          "removeComponentMapping"
        ]
      },
      "set-common-resource-dirs": {
