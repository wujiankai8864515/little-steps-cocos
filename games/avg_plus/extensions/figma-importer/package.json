        "methods": [
          "attachMatchedNodeAsChildBeta"
        ]
      }
    },
    "scene": {
      "script": "./dist/scene.js",
      "methods": [
        "getSceneBuildVersion",
        "getComponentStateRuntimeRevision",
        "describeComponentMappingSelection",
        "getImportContext",
        "createEmptyNode",
        "buildTree",
        "replaceImagePlaceholders",
        "applyComponentStates",
        "restoreComponentStateActivity",
        "applyMappedComponentStates",
        "buildTextStyleRoot",
        "exportTreeForFigma",
        "describeNodeForReplaceBeta",
        "listReplaceTargetsBeta",
        "snapshotReplaceTargetBeta",
        "restoreReplaceTargetBeta",
        "selectReplaceTargetBeta",
        "applyNodePatchBeta",
        "serializeNodeAsPrefabBeta",
        "instantiatePrefabBeta",
        "replaceTreeBeta"
      ]
