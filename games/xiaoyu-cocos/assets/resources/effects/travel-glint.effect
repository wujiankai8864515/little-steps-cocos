CCEffect %{
  techniques:
  - passes:
    - vert: glint-vs:vert
      frag: glint-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
}%
CCProgram glint-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 ink;
  vec4 vert () {
    vec4 pos=vec4(a_position,1.0);
    #if USE_LOCAL
      pos=cc_matWorld*pos;
    #endif
    uv0=a_texCoord;
    vec3 tint=vec3(1.0);
    if(a_color.r<0.5) tint=vec3(1.0,0.86,0.52);
    else if(a_color.r<1.5) tint=vec3(1.0,0.78,0.34);
    else if(a_color.r>2.5) tint=vec3(1.0,0.88,0.50);
    ink=vec4(tint,a_color.g*a_color.a);
    return cc_matViewProj*pos;
  }
}%
CCProgram glint-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 ink;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  vec4 frag () { return CCSampleWithAlphaSeparated(cc_spriteTexture,uv0)*ink; }
}%
