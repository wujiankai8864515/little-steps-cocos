// Source formulas transferred by builds/tools/import_godot_lighting.py.
CCEffect %{
  techniques:
  - passes:
    - vert: room-vs:vert
      frag: room-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        pageOrigin: { value: [0, 0, 1, 1] }
        pageState: { value: [0, 1280, 1280, 1] }
        wardrobeState: { value: [0, 0.5, 0, 1] }
}%

CCProgram room-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  out vec2 canvasPosition;
  vec4 vert() {
    vec4 pos=vec4(a_position,1.0);
    #if USE_LOCAL
      pos=cc_matWorld*pos;
    #endif
    uv0=a_texCoord; color=a_color; canvasPosition=pos.xy;
    return cc_matViewProj*pos;
  }
}%

CCProgram room-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 color;
  in vec2 canvasPosition;
uniform WardrobeLight {vec4 pageOrigin;vec4 pageState;vec4 wardrobeState;};
#define night wardrobeState.x
#define solar_phase wardrobeState.y
#define glass_pass (wardrobeState.z>0.5 && wardrobeState.z<1.5)
#define shaft_pass (wardrobeState.z>1.5 && wardrobeState.z<2.5)
#define shadow_pass (wardrobeState.z>2.5)
#define volume_gain wardrobeState.w

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

vec4 frag(){vec2 point=vec2((canvasPosition.x-pageOrigin.x)/pageOrigin.z,(pageOrigin.y-canvasPosition.y)/pageOrigin.w);vec4 result=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0)*color;
 if(glass_pass){
  float sheen=exp(-pow((point.x*0.72+point.y*0.16-90.0-solar_phase*34.0)/24.0,2.0));
  result=vec4(mix(vec3(0.89,0.95,1.0),vec3(0.53,0.72,1.0),night),0.045+sheen*0.14);
 }
 else if(shadow_pass){result=vec4(vec3(0.11,0.065,0.07),result.a*0.24);}
 else {
 vec2 origin=vec2(-90.0,pageState.x+mix(110.0,330.0,solar_phase));
 vec2 axis=normalize(vec2(mix(0.85,1.4,solar_phase),0.92));
 vec2 relative=point-origin;
 float distance_along=dot(relative,axis);
 float across=abs(relative.x*axis.y-relative.y*axis.x);
 float spread=55.0+max(distance_along,0.0)*0.19;
 float beam=exp(-pow(across/spread,2.0))*smoothstep(-80.0,170.0,distance_along);
 float secondary=exp(-pow((across-145.0)/(spread*0.6),2.0))*0.22;
 vec3 tint=mix(vec3(1.0,0.9,0.75),vec3(0.51,0.62,0.85),night);
 if(shaft_pass){
  // Three soft angular fans reveal volume without hard periodic stripes.
  // point is room-local MODEL space inside the fixed SubViewport, never
  // FRAGCOORD/SCREEN_UV, so letterboxing and parent translation cannot drift it.
  float angle=atan(relative.y,relative.x)-atan(axis.y,axis.x);
  angle=atan(sin(angle),cos(angle));
  float a=exp(-0.5*pow((angle+0.19)/0.052,2.0));
  float b=exp(-0.5*pow((angle-0.015)/0.075,2.0));
  float c=exp(-0.5*pow((angle-0.235)/0.058,2.0));
  float depth=exp(-length(relative)/(1900.0*max(1.0,pageState.z/1280.0)));
  float entry=smoothstep(-30.0,145.0,distance_along);
  float floor_fade=1.0-smoothstep(pageState.y-420.0,pageState.y,point.y);
  float volume=(a*0.78+b+c*0.70)*depth*entry*floor_fade;
  result=vec4(tint,min(0.34,volume*mix(0.42,0.27,night))*volume_gain);
 }
 else {vec3 ambient=mix(vec3(0.85,0.79,0.7),vec3(0.39,0.43,0.58),night);
 result.rgb*=ambient+tint*(beam+secondary)*mix(0.39,0.22,night);}
 }
return result;}
}%
