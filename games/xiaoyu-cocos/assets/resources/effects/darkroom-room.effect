// Source formulas transferred by builds/tools/import_godot_lighting.py.
CCEffect %{
  techniques:
  - passes:
    - vert: room-vs:vert
      frag: room-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        roomOrigin: { value: [0, 0, 1, 1] }
        sourceUV: { value: [0, 0, 1, 1] }
        visibleUV: { value: [0, 0, 1, 1] }
        ambientState: { value: [0.55, 0.59, 0.63, 0.43] }
        sunState: { value: [1, 0.91, 0.76, 0] }
        sunVectorState: { value: [0, 0, 1, 1] }
        castState: { value: [0.6, 0.6, -0.32, 0.95] }
        timeState: { value: [7, 1, 0, 0] }
        weightsState: { value: [1, 0, 0, 1] }
        celestialState: { value: [147.5, 63.55, 228, 95] }
        maskRect: { value: [0, 0, 1, 1] }
        textureSize: { value: [1, 1, 0, 0] }
        darkState: { value: [0, -1, 0.018, 0] }
        textureBounds: { value: [0, 0, 1, 1] }
        toolInverseX: { value: [1, 0, 0, 0] }
        toolInverseY: { value: [0, 1, 0, 0] }
        toolInverseOrigin: { value: [0, 0, 0, 0] }
        toolUVRect: { value: [0, 0, 1, 1] }
        toolRect: { value: [0, 0, 1, 1] }
}%

CCProgram room-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  out vec2 canvasPosition;
  vec4 vert() {
    vec4 pos=vec4(a_position,1.0);
    #if USE_LOCAL
      pos=cc_matWorld*pos;
    #endif
    uv0=a_texCoord; color=a_color; canvasPosition=pos.xy;
    return cc_matViewProj*pos;
  }
}%

CCProgram room-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 color;
  in vec2 canvasPosition;

  uniform RoomState {
    vec4 roomOrigin;
    vec4 sourceUV;
    vec4 visibleUV;
    vec4 ambientState;
    vec4 sunState;
    vec4 sunVectorState;
    vec4 castState;
    vec4 timeState;
    vec4 weightsState;
    vec4 celestialState;
    vec4 maskRect;
  };
  #define ambient_color ambientState.rgb
  #define sun_energy ambientState.a
  #define sun_color sunState.rgb
  #define moon_energy sunState.a
  #define sun_vector sunVectorState.xyz
  #define cot_e sunVectorState.w
  #define cast_dir castState.xy
  #define moon_cast_dir castState.zw
  #define game_hour timeState.x
  #define daylight timeState.y
  #define noon_weight timeState.z
  #define afterglow_energy timeState.w
  #define morning_weight weightsState.x
  #define sunset_weight weightsState.y
  #define lamp_glow (weightsState.z / 0.78)
  #define surface_type weightsState.w
  #define sun_screen_position celestialState.xy
  #define moon_screen_position celestialState.zw
  #define visible_uv visibleUV
  #define show_mask false
  #define outdoor_enabled true
  #define use_shared_outdoor_paint true
  #define shared_outdoor_uv_rect vec4(0.0,0.0,1.0,1.0)

  uniform DarkExtras {
    vec4 textureSize;
    vec4 darkState;
    vec4 textureBounds;
    vec4 toolInverseX;
    vec4 toolInverseY;
    vec4 toolInverseOrigin;
    vec4 toolUVRect;
    vec4 toolRect;
  };
  #define lamp_weight darkState.x
  #define release_glow darkState.y
  #define selected darkState.x
  #define radius_px darkState.y
  #define age darkState.x
  #define alpha darkState.y
  #define flutter darkState.z
  #define strength darkState.x
  #define doll_part_id int(darkState.y)
  #define mother_uv_rect vec4(0.0,0.0,1.0,1.0)
  #define texture_bounds textureBounds
  #define tool_inverse_x toolInverseX.xy
  #define tool_inverse_y toolInverseY.xy
  #define tool_inverse_origin toolInverseOrigin.xy
  #define tool_uv_rect toolUVRect
  #define tool_rect toolRect

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;


  vec4 sourceSample(vec2 p) {
    vec2 q=(p-sourceUV.xy)/sourceUV.zw;
    float gate=step(0.0,q.x)*step(q.x,1.0)*step(0.0,q.y)*step(q.y,1.0);
    return CCSampleWithAlphaSeparated(cc_spriteTexture,clamp(q,vec2(0.0),vec2(1.0)))*gate;
  }


// Darkroom's actual window geometry, floor and central mullion only.
// One continuous 2.5D projector. Adapters supply actual room geometry/occluders.
float shared_window_u(vec2 p,vec2 direction,vec4 geometry,float floor_y){
 float depth=max(p.y-geometry.y,0.0);
 float floor_depth=max(p.y-floor_y,0.0);
 float width=geometry.z+depth*geometry.w;
 float center=geometry.x+direction.x*(depth*0.43+floor_depth*0.22);
 return (p.x-center)/width;
}
float shared_window_field(vec2 point,vec2 direction,float cotangent,vec4 geometry,float floor_y,vec2 aperture,vec2 start,vec4 reach,vec3 mullion,float baseline,float leaf_breakup){
 float depth=max(point.y-geometry.y,0.0);
 float u=shared_window_u(point,direction,geometry,floor_y);
 float gate=1.0-smoothstep(aperture.x,aperture.y,abs(u));
 float pane=baseline+(1.0-baseline)*smoothstep(mullion.y,mullion.z,abs(u-mullion.x));
 float leaves=sin(u*48.0+depth*0.018)*sin(u*29.0-depth*0.022);
 float edge=1.0-leaf_breakup*smoothstep(0.53,0.96,abs(u))*(0.5+0.5*leaves);
 return gate*pane*edge*smoothstep(start.x,start.y,point.y)*(1.0-smoothstep(reach.x+cotangent*reach.z,reach.y+cotangent*reach.w,point.y));
}

float dark_window_field(vec2 p,vec2 direction,float cotangent){
 return shared_window_field(p,direction,cotangent,vec4(491.0,370.0,146.0,0.38),850.0,vec2(0.82,1.06),vec2(350.0,410.0),vec4(1130.0,1320.0,20.0,20.0),vec3(0.23,0.038,0.085),0.43,0.0);
}














 vec4 frag() {
    vec2 UV=sourceUV.xy+uv0*sourceUV.zw;
    vec2 TEXTURE_PIXEL_SIZE=1.0/textureSize.xy;
    vec2 world_pos=vec2((canvasPosition.x-roomOrigin.x)/roomOrigin.z,(roomOrigin.y-canvasPosition.y)/roomOrigin.w);
    vec2 world_position=world_pos;
    vec4 result;

    vec4 base=sourceSample(UV);
    vec3 cool=vec3(0.47,0.50,0.72);
    vec3 sun=mix(vec3(1.12,1.09,1.03),vec3(1.23,0.84,0.62),sunset_weight);
    vec3 light=mix(cool,sun,daylight);
    vec2 p=world_pos/vec2(720.0,1280.0);
    float day_gate=dark_window_field(world_pos,cast_dir,cot_e);
    float moon_gate=dark_window_field(world_pos,moon_cast_dir,1.6);
    float lantern=exp(-dot((p-vec2(0.115,0.438))*vec2(3.9,3.0),(p-vec2(0.115,0.438))*vec2(3.9,3.0)));
    float release=exp(-dot((p-vec2(0.5,0.56))*vec2(3.7,3.2),(p-vec2(0.5,0.56))*vec2(3.7,3.2)));
    vec3 lit=base.rgb*light;
    lit+=base.rgb*sun_color*day_gate*sun_energy*0.40;
    lit+=vec3(0.03,0.08,0.15)*moon_gate*moon_energy;
    lit+=base.rgb*vec3(1.0,0.29,0.11)*day_gate*afterglow_energy*0.20;
    lit+=vec3(0.38,0.17,0.035)*lantern*lamp_weight;
    lit+=vec3(0.35,0.19,0.055)*release*release_glow;
    result=vec4(lit,base.a)*color;

    return result;
 }

}%
