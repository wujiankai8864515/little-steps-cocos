CCEffect %{
  techniques:
  - passes:
    - vert: login-vs:vert
      frag: login-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        peekState: { value: [96, 361, 0, 720] }
}%
CCProgram login-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert() {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord; color = a_color;
    return cc_matViewProj * pos;
  }
}%
CCProgram login-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 color;
  uniform LoginState { vec4 peekState; };
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  vec4 frag() {
    vec4 pixel = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    float sourceX = peekState.z + uv0.x * peekState.w;
    pixel.a *= 1.0 - smoothstep(peekState.y - 0.65, peekState.y, sourceX + peekState.x);
    return pixel * color;
  }
}%
