// home/feedback/merit_amount_art.gd: retain original pixels and enforce warm gold.
CCEffect %{
  techniques:
  - passes:
    - vert: merit-vs:vert
      frag: merit-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
}%
CCProgram merit-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert() {
    vec4 pos=vec4(a_position,1.0);
    #if USE_LOCAL
      pos=cc_matWorld*pos;
    #endif
    uv0=a_texCoord; color=a_color;
    return cc_matViewProj*pos;
  }
}%
CCProgram merit-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 color;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  vec4 frag() {
    vec4 ink=CCSampleWithAlphaSeparated(cc_spriteTexture,uv0);
    return vec4(max(ink.rgb,vec3(1.0,0.79,0.35)),ink.a)*color;
  }
}%
